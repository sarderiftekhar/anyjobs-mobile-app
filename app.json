{
  "expo": {
    "name": "ContinentJobs",
    "slug": "continentjobs",
    "owner": "sarderiftekhar",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "continentjobs",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0064EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.continentjobs.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.continentjobs.mobile",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0064EC",
          "defaultChannel": "default"
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "ContinentJobs needs access to your photos so you can add a profile photo or upload your company logo, banner and gallery images.",
          "microphonePermission": false
        }
      ]
    ],
    "notification": {
      "color": "#0064EC"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6de38191-ca96-4837-a8c5-463f8d605b98"
      }
    }
  }
}
